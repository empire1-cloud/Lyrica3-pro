# Lyrica 3 Pro — Backend Environment
# Copy this to backend/.env and fill in real values

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: spin up MongoDB with `docker run -d -p 27017:27017 mongo`
# or use MongoDB Atlas free tier: https://cloud.mongodb.com
MONGO_URL=mongodb://localhost:27017
DB_NAME=lyrica3_dev

# ── Auth ──────────────────────────────────────────────────────────────────────
# Change this before any real usage — use a random 32-char string
JWT_SECRET=dev_secret_change_me_before_prod

# ── Full Runtime v1 (Empire-local production lane) ───────────────────────────
# Keep disabled until the branch is intentionally activated in an environment.
LYRICA_FULL_RUNTIME_V1_ENABLED=false
LYRICA_PROVIDER_MODE=empire_local
# Required for signed VICS proof issuance. Use a random value of at least 32 chars.
LYRICA_VICS_PROOF_SIGNING_KEY=

# Existing Archisynapse v2 Flip cutover remains separately gated.
LYRICA_ARCHISYNAPSE_V2_ENABLED=false

# ── Legacy / optional AI providers ───────────────────────────────────────────
# These do not power the new Full Runtime v1 path.
EMERGENT_LLM_KEY=
GOOGLE_API_KEY=
REPLICATE_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local dev: allow all origins
CORS_ORIGINS=*

# ── Redis (optional — falls back to in-memory if not set) ────────────────────
# REDIS_URL=redis://localhost:6379

# ── File TTLs ─────────────────────────────────────────────────────────────────
VOICE_TTL_MIN=240
UPLOAD_TTL_MIN=1440

# ── Features ──────────────────────────────────────────────────────────────────
DEMUCS_ENABLED=false
